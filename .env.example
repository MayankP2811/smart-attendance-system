# Copy this file to .env and fill in your own values.  .env is never committed.
# The website (web/) and the Raspberry Pi station (device/) both read it.

# --- Database (MySQL 8 or MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_attendance
DB_USER=attendance_app
DB_PASSWORD=change-me

# Time zone for lecture times and the website
APP_TIMEZONE=Asia/Kolkata
# 1 shows PHP error details in the browser (only on your own computer)
APP_DEBUG=0

# --- Raspberry Pi station ---
# Fingerprint sensor (R30x / Adafruit-compatible) on a USB-to-serial adapter
FINGERPRINT_PORT=/dev/ttyUSB0
FINGERPRINT_BAUD=57600
# 16x2 I2C LCD (PCF8574 backpack)
LCD_I2C_ADDRESS=0x27
# Camera: OpenCV device index and resolution
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
# The camera inside the classroom takes CAPTURE_COUNT photos at random moments
# spread over the whole lecture. A student is present only if recognised in at
# least MIN_PRESENCE of the photos (0.6 = 60 %, i.e. 4 of 6), so leaving early counts as absent.
CAPTURE_COUNT=6
MIN_PRESENCE=0.6
# Face matching: lower tolerance = stricter (the face_recognition default is 0.6)
FACE_TOLERANCE=0.5
FACE_MODEL=hog
FACE_UPSAMPLE=1
ENCODINGS_FILE=device/data/encodings.npz
# Lecture length: photos are spread over it and the LCD counts it down
LECTURE_MINUTES=60
# Keep the classroom photos (with boxes and names drawn) in device/captures/
SAVE_CAPTURES=1
